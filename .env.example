# ════════════════════════════════════════════════════════════════
# IssueTrack — root environment template (used by docker-compose)
# Copy to `.env`:  cp .env.example .env   and replace every secret.
#
# The API reads `server/.env` when you run it with npm (see
# server/.env.example — same variables). The client reads
# `client/.env.local` (see client/.env.example).
# ════════════════════════════════════════════════════════════════

# ── API ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ────────────────────────────────────────────────────
# Local docker-compose MongoDB (compose overrides the host to `mongo`):
MONGODB_URI=mongodb://127.0.0.1:27017/issuetrack
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/issuetrack?retryWrites=true&w=majority

# ── Auth ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 48
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=it_token
# true behind HTTPS (production). Cross-site front-end? also set SAME_SITE=none
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ── CORS — comma-separated browser origins allowed to call the API ──
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Wildcard patterns for hosted previews, e.g. https://*.vercel.app
# (development always trusts https://*.e2b.app sandbox previews)
CLIENT_ORIGIN_PATTERNS=

# ── Uploads ─────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ── Rate limiting ───────────────────────────────────────────────
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=30
API_RATE_LIMIT_WINDOW_MINUTES=15
API_RATE_LIMIT_MAX=2000

# ── Demo seed (development only — never used in production) ─────
SEED_DEMO_PASSWORD=Password123!

# ── Tests ───────────────────────────────────────────────────────
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/issuetrack_test

# ── Web client (Vite build-time variables) ──────────────────────
# Empty = use relative `/api` (Vite dev proxy / nginx proxy).
# On Vercel set the Render/Railway API origin, e.g. https://issuetrack-api.onrender.com/api
VITE_API_URL=
VITE_PROXY_TARGET=http://localhost:4000
