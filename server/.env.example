# ─────────────────────────────────────────────────────────────
# IssueTrack API — environment variables
# Copy to .env and adjust. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# MongoDB (local Docker) — or your MongoDB Atlas SRV string
MONGODB_URI=mongodb://127.0.0.1:27017/issuetrack

# Auth — generate with: openssl rand -hex 48
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Session cookie
COOKIE_NAME=it_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional wildcard origin patterns (comma separated) for hosted previews,
# e.g. https://*.my-preview.app or https://*.vercel.app
# (development already trusts https://*.e2b.app sandbox previews)
CLIENT_ORIGIN_PATTERNS=

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=30
API_RATE_LIMIT_WINDOW_MINUTES=15
API_RATE_LIMIT_MAX=2000

# Demo seed password (development only)
SEED_DEMO_PASSWORD=Password123!

# Test database (used by `npm test`)
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/issuetrack_test

# Optional: Clerk secret key (Clerk dashboard -> API keys). Enables Google/GitHub sign-in.
# The API verifies every Clerk session token with this key before signing anyone in.
CLERK_SECRET_KEY=

# Alternative to CLERK_SECRET_KEY: the Clerk instance PUBLIC key (PEM, from https://<frontend-api>/.well-known/jwks.json).
# Requires custom session claims: email={{user.primary_email_address}}, name={{user.full_name}}, picture={{user.image_url}}.
CLERK_JWT_KEY=
