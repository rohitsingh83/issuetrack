# ─────────────────────────────────────────────────────────────
# IssueTrack web client — environment variables
# Copy to .env.local for local overrides. NEVER commit secrets.
# ─────────────────────────────────────────────────────────────

# Base URL of the API. Leave empty in local development so that Vite
# proxies /api and /socket.io to http://localhost:4000 (see vite.config.ts).
# In production (e.g. Vercel + Render) set the full API origin:
#   VITE_API_URL=https://issuetrack-api.onrender.com
VITE_API_URL=

# Optional: where the dev server proxies requests when VITE_API_URL is empty
VITE_PROXY_TARGET=http://localhost:4000

# Optional: Clerk publishable key - shows 'Continue with Google or GitHub'.
# Needs CLERK_SECRET_KEY on the API too (see server/.env.example).
VITE_CLERK_PUBLISHABLE_KEY=
